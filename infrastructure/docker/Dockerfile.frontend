FROM node:22-alpine AS builder
ARG WORKSPACE=@mail/web
ARG APP_DIR=apps/web
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api/package.json ./apps/api/package.json
COPY services/scheduler/package.json ./services/scheduler/package.json
COPY services/mailbox-service/package.json ./services/mailbox-service/package.json
COPY apps/web ./apps/web
COPY apps/mail ./apps/mail
COPY apps/admin ./apps/admin
RUN npm ci --ignore-scripts
RUN npm run build -w @mail/shared-types && npm run build -w @mail/validation && npm run build -w @mail/ui && npm run build -w ${WORKSPACE}

FROM nginx:alpine
ARG APP_DIR=apps/web
COPY --from=builder /app/${APP_DIR}/dist /usr/share/nginx/html
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
