driver = pgsql
connect = host=__POSTGRES_HOST__ dbname=__POSTGRES_DB__ user=__POSTGRES_USER__ password=__POSTGRES_PASSWORD__
default_pass_scheme = ARGON2ID

password_query = \
  SELECT m.email_address AS user, m.password_hash AS password \
  FROM mailboxes m \
  JOIN domains d ON d.id = m.domain_id \
  WHERE m.email_address = '%u' \
    AND m.status = 'active' \
    AND d.hosting_enabled = TRUE \
    AND d.is_suspended = FALSE

user_query = \
  SELECT '/var/mail/vhosts/' || d.domain_name || '/' || m.local_part AS home, \
         5000 AS uid, \
         5000 AS gid, \
         '*:bytes=' || m.quota_bytes AS quota_rule \
  FROM mailboxes m \
  JOIN domains d ON d.id = m.domain_id \
  WHERE m.email_address = '%u' \
    AND m.status = 'active' \
    AND d.hosting_enabled = TRUE \
    AND d.is_suspended = FALSE
