# ==============================================================================
# 1. YOUR DOMAIN & QUICK-START IDENTITY (EDIT THESE FIRST BEFORE DEPLOYING)
# ==============================================================================
PRIMARY_DOMAIN=yourdomain.com
MAIL_HELO_DOMAIN=mx1.yourdomain.com
SMTP_SERVER_DOMAIN=mx1.yourdomain.com
DKIM_SELECTOR=mp1
DKIM_AUTO_GENERATE=true

# Bootstrap initial workspace + Super Admin login + primary domain on API startup
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeThisStrongPassword123!
ADMIN_BOOTSTRAP_ORG=Primary Mail Org

# Optional SMTP relay client login for apps using port 587/465 (Nodemailer, Laravel, etc.)
SMTP_AUTH_USERNAME=relay-app
SMTP_AUTH_PASSWORD=ChangeThisSmtpPassword123!

# ==============================================================================
# 2. APPLICATION ENVIRONMENT & CORS
# ==============================================================================
NODE_ENV=production
LOG_LEVEL=info
API_PORT=4000
API_HOST=0.0.0.0
# Add your cloud dashboard domains here (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_CORS_ORIGINS=http://localhost:5175

# ==============================================================================
# 3. SECURITY SECRETS (GENERATE 32+ CHAR RANDOM VALUES IN PRODUCTION)
# ==============================================================================
JWT_ACCESS_SECRET=replace_with_at_least_32_byte_random_access_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_byte_random_refresh_secret
DKIM_KEK_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MAIL_ENGINE_CONTROL_TOKEN=replace_with_random_control_token

# ==============================================================================
# 4. DATABASES & BROKER
# ==============================================================================
POSTGRES_USER=mailplat
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_DB=mailplat
DATABASE_URL=postgresql://mailplat:change_me_local_dev_only@postgres:5432/mailplat

REDIS_PASSWORD=change_me_redis_dev_only
REDIS_URL=redis://:change_me_redis_dev_only@redis:6379

RABBITMQ_USER=mailplat
RABBITMQ_PASSWORD=change_me_local_dev_only
RABBITMQ_URL=amqp://mailplat:change_me_local_dev_only@rabbitmq:5672/%2f
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672

# ==============================================================================
# 5. MESSAGE SPOOL STORAGE (local NVMe volume OR s3/MinIO)
# ==============================================================================
SPOOL_BACKEND=local
SPOOL_DIR=/var/spool/mailplat
# Set SPOOL_BACKEND=s3 and fill below to store MIME bodies in MinIO / AWS S3 / R2:
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mail-spool
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminsecret

# ==============================================================================
# 6. RUST MTA ENGINE PORTS & TLS CERTS
# ==============================================================================
MAIL_ENGINE_NODE_ID=mta-primary-1
MAIL_ENGINE_ROLES=ingress,outbound,inbound
MAIL_ENGINE_CONTROL_URL=http://mail-engine:9100
SMTP_PORT_25=25
SMTP_PORT_587=587
SMTP_PORT_465=465
METRICS_PORT=9100
TLS_CERT_PATH=/etc/mail-certs/fullchain.pem
TLS_KEY_PATH=/etc/mail-certs/privkey.pem

# ==============================================================================
# 7. DOVECOT (INBOUND MAILBOXES & WEBMAIL)
# ==============================================================================
DOVECOT_LMTP_HOST=dovecot
DOVECOT_LMTP_PORT=24
DOVECOT_IMAP_HOST=dovecot
DOVECOT_IMAP_PORT=143
