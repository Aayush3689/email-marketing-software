// Aligned with migrations/0001_initial_schema.sql (SQL-first migration authority).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @db.Uuid
  email           String    @unique @db.Citext
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")
  status          String    @default("active")
  platformRole    String    @default("none") @map("platform_role")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  sessions    UserSession[]
  memberships OrganizationMember[]

  @@map("users")
}

model UserSession {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  appSurface       String    @map("app_surface")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  tokenFamilyId    String    @map("token_family_id") @db.Uuid
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent")
  mfaVerifiedAt    DateTime? @map("mfa_verified_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Organization {
  id               String   @id @db.Uuid
  name             String
  slug             String   @unique @db.Citext
  status           String   @default("active")
  sendingMode      String   @default("sandbox") @map("sending_mode")
  defaultIpPoolId  String?  @map("default_ip_pool_id") @db.Uuid
  dailySendLimit   Int      @default(500) @map("daily_send_limit")
  monthlySendLimit Int      @default(10000) @map("monthly_send_limit")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  members   OrganizationMember[]
  domains   Domain[]
  apiKeys   ApiKey[]
  mailboxes Mailbox[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Domain {
  id                     String    @id @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  domainName             String    @unique @map("domain_name") @db.Citext
  verificationToken      String    @map("verification_token")
  ownershipVerifiedAt    DateTime? @map("ownership_verified_at") @db.Timestamptz
  sendingEnabled         Boolean   @default(false) @map("sending_enabled")
  hostingEnabled         Boolean   @default(false) @map("hosting_enabled")
  isSuspended            Boolean   @default(false) @map("is_suspended")
  suspensionReason       String?   @map("suspension_reason")
  activeDkimSelector     String?   @map("active_dkim_selector")
  dkimPolicy             String    @default("required") @map("dkim_policy")
  customReturnPathDomain String?   @map("custom_return_path_domain") @db.Citext
  customTrackingDomain   String?   @map("custom_tracking_domain") @db.Citext
  defaultSenderLocalPart String?   @map("default_sender_local_part")
  dmarcPolicy            String    @default("none") @map("dmarc_policy")
  dmarcRua               String?   @map("dmarc_rua")
  dmarcRuf               String?   @map("dmarc_ruf")
  dmarcPct               Int       @default(100) @map("dmarc_pct") @db.SmallInt
  dmarcAspf              String    @default("r") @map("dmarc_aspf")
  dmarcAdkim             String    @default("r") @map("dmarc_adkim")
  dailySendLimit         Int?      @map("daily_send_limit")
  mtaStsMode             String    @default("none") @map("mta_sts_mode")
  mtaStsMaxAge           Int       @default(86400) @map("mta_sts_max_age")
  tlsRptRua              String?   @map("tls_rpt_rua")
  bimiSelector           String    @default("default") @map("bimi_selector")
  bimiLogoUrl            String?   @map("bimi_logo_url")
  bimiVmcUrl             String?   @map("bimi_vmc_url")
  lastDnsCheckedAt       DateTime? @map("last_dns_checked_at") @db.Timestamptz
  lastAuthPassedAt       DateTime? @map("last_auth_passed_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailboxes    Mailbox[]
  dkimKeys     DkimKey[]
  dnsChecks    DomainDnsCheck[]
  dnsJobs      DomainDnsJob[]

  @@map("domains")
}

model DkimKey {
  id                   String    @id @db.Uuid
  domainId             String    @map("domain_id") @db.Uuid
  selector             String
  algorithm            String
  publicKeyDnsTxt      String    @map("public_key_dns_txt")
  encryptedPrivateKey  Bytes     @map("encrypted_private_key")
  keyEncryptionVersion Int       @default(1) @map("key_encryption_version")
  status               String    @default("active")
  rotatedAt            DateTime? @map("rotated_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, selector])
  @@map("dkim_keys")
}

model DomainDnsCheck {
  id         String   @id @db.Uuid
  domainId   String   @map("domain_id") @db.Uuid
  spfStatus  String   @map("spf_status")
  dkimStatus String   @map("dkim_status")
  dmarcStatus String  @map("dmarc_status")
  mxStatus   String   @map("mx_status")
  ptrStatus  String   @map("ptr_status")
  details    Json     @default("{}")
  checkedAt  DateTime @default(now()) @map("checked_at") @db.Timestamptz

  domain Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  jobs   DomainDnsJob[]

  @@map("domain_dns_checks")
}

model DomainDnsJob {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  domainId       String    @map("domain_id") @db.Uuid
  status         String    @default("queued")
  triggerSource  String    @default("manual") @map("trigger_source")
  requestedBy    String?   @map("requested_by") @db.Uuid
  resultCheckId  String?   @map("result_check_id") @db.Uuid
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  startedAt      DateTime? @map("started_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz

  domain      Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  resultCheck DomainDnsCheck? @relation(fields: [resultCheckId], references: [id], onDelete: SetNull)

  @@map("domain_dns_jobs")
}

model ApiKey {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  keyPrefix      String    @map("key_prefix") @db.VarChar(16)
  keyHash        String    @unique @map("key_hash")
  scopes         String[]
  rateLimitRpm   Int       @default(600) @map("rate_limit_rpm")
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Mailbox {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  domainId       String   @map("domain_id") @db.Uuid
  serverId       String   @map("server_id") @db.Uuid
  localPart      String   @map("local_part") @db.Citext
  emailAddress   String   @unique @map("email_address") @db.Citext
  passwordHash   String   @map("password_hash")
  displayName    String   @default("") @map("display_name")
  quotaBytes     BigInt   @default(5368709120) @map("quota_bytes")
  usedBytes      BigInt   @default(0) @map("used_bytes")
  status         String   @default("active")
  isCatchAll     Boolean  @default(false) @map("is_catch_all")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain       Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, localPart])
  @@map("mailboxes")
}

model Contact {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  email            String    @db.Citext
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  status           String    @default("subscribed")
  tags             String[]  @default([])
  attributes       Json      @default("{}")
  consentSource    String    @map("consent_source")
  consentedAt      DateTime  @default(now()) @map("consented_at") @db.Timestamptz
  unsubscribedAt   DateTime? @map("unsubscribed_at") @db.Timestamptz
  lastActivityAt   DateTime? @map("last_activity_at") @db.Timestamptz
  engagementScore  Int       @default(0) @map("engagement_score")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  subscriberTags      SubscriberTag[]
  subscriberEvents    SubscriberEvent[]
  sequenceEnrollments SequenceEnrollment[]
  automationRuns      AutomationRun[]

  @@unique([organizationId, email])
  @@map("contacts")
}

model Tag {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.Citext
  description    String   @default("")
  color          String   @default("#2563eb")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  subscriberTags SubscriberTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model SubscriberTag {
  subscriberId String   @map("subscriber_id") @db.Uuid
  tagId        String   @map("tag_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  subscriber Contact @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  tag        Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([subscriberId, tagId])
  @@map("subscriber_tags")
}

model CustomField {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fieldKey       String   @map("field_key")
  label          String
  fieldType      String   @default("text") @map("field_type")
  description    String   @default("")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([organizationId, fieldKey])
  @@map("custom_fields")
}

model SubscriberEvent {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  subscriberId   String   @map("subscriber_id") @db.Uuid
  eventType      String   @map("event_type")
  source         String?
  detail         Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  subscriber Contact @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@map("subscriber_events")
}

model Segment {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String   @default("")
  matchType      String   @default("all") @map("match_type")
  conditions     Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("segments")
}

model ContactImportJob {
  id                  String    @id @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  status              String    @default("queued")
  fileName            String?   @map("file_name")
  consentSource       String    @map("consent_source")
  defaultTags         String[]  @default([]) @map("default_tags")
  fieldMapping        Json      @default("{}") @map("field_mapping")
  totalRows           Int       @default(0) @map("total_rows")
  importedCount       Int       @default(0) @map("imported_count")
  updatedCount        Int       @default(0) @map("updated_count")
  skippedDuplicates   Int       @default(0) @map("skipped_duplicates")
  invalidCount        Int       @default(0) @map("invalid_count")
  suppressedCount     Int       @default(0) @map("suppressed_count")
  missingConsentCount Int       @default(0) @map("missing_consent_count")
  failedCount         Int       @default(0) @map("failed_count")
  errorReport         Json      @default("[]") @map("error_report")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt         DateTime? @map("completed_at") @db.Timestamptz

  @@map("contact_import_jobs")
}

model Template {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  category       String    @default("transactional")
  description    String    @default("")
  activeVersion  Int       @default(1) @map("active_version")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  versions TemplateVersion[]

  @@map("templates")
}

model TemplateVersion {
  id             String   @id @db.Uuid
  templateId     String   @map("template_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  subject        String
  previewText    String   @default("") @map("preview_text")
  htmlBody       String   @default("") @map("html_body")
  textBody       String   @default("") @map("text_body")
  blocksJson     Json     @default("[]") @map("blocks_json")
  variableSchema Json     @default("{}") @map("variable_schema")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, versionNumber])
  @@map("template_versions")
}

model Campaign {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  domainId          String    @map("domain_id") @db.Uuid
  templateVersionId String?   @map("template_version_id") @db.Uuid
  name              String
  status            String    @default("draft")
  fromName          String    @default("") @map("from_name")
  fromEmail         String?   @map("from_email")
  replyTo           String?   @map("reply_to")
  subject           String?
  previewText       String    @default("") @map("preview_text")
  htmlBody          String?   @map("html_body")
  textBody          String?   @map("text_body")
  blocksJson        Json      @default("[]") @map("blocks_json")
  audienceSpec      Json      @default("{}") @map("audience_spec")
  timezone          String    @default("UTC")
  scheduledAt       DateTime? @map("scheduled_at") @db.Timestamptz
  dispatchedAt      DateTime? @map("dispatched_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz
  failureReason     String?   @map("failure_reason")
  targetFilter      Json      @default("{}") @map("target_filter")
  statsCache        Json      @default("{}") @map("stats_cache")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  recipients CampaignRecipient[]

  @@map("campaigns")
}

model CampaignRecipient {
  id             String   @id @db.Uuid
  campaignId     String   @map("campaign_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  subscriberId   String?  @map("subscriber_id") @db.Uuid
  recipientEmail String   @map("recipient_email") @db.Citext
  status         String   @default("pending")
  messageId      String?  @map("message_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, recipientEmail])
  @@map("campaign_recipients")
}

model EmailSequence {
  id                String   @id @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  domainId          String?  @map("domain_id") @db.Uuid
  name              String
  description       String   @default("")
  fromName          String   @default("") @map("from_name")
  fromEmail         String?  @map("from_email")
  replyTo           String?  @map("reply_to")
  enabled           Boolean  @default(false)
  allowReentry      Boolean  @default(false) @map("allow_reentry")
  exitOnUnsubscribe Boolean  @default(true) @map("exit_on_unsubscribe")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@map("email_sequences")
}

model SequenceStep {
  id          String   @id @db.Uuid
  sequenceId  String   @map("sequence_id") @db.Uuid
  position    Int
  delayDays   Int      @default(0) @map("delay_days")
  delayHours  Int      @default(0) @map("delay_hours")
  subject     String
  previewText String   @default("") @map("preview_text")
  htmlBody    String   @default("") @map("html_body")
  textBody    String   @default("") @map("text_body")
  blocksJson  Json     @default("[]") @map("blocks_json")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@map("sequence_steps")
}

model SequenceEnrollment {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  sequenceId       String    @map("sequence_id") @db.Uuid
  subscriberId     String    @map("subscriber_id") @db.Uuid
  currentStepIndex Int       @default(0) @map("current_step_index")
  status           String    @default("active")
  nextSendAt       DateTime? @map("next_send_at") @db.Timestamptz
  lastSentAt       DateTime? @map("last_sent_at") @db.Timestamptz
  exitedReason     String?   @map("exited_reason")
  enrolledAt       DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz

  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  subscriber Contact       @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@map("sequence_enrollments")
}

model Automation {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String   @default("")
  status         String   @default("draft")
  triggerType    String   @map("trigger_type")
  triggerConfig  Json     @default("{}") @map("trigger_config")
  nodes          Json     @default("[]")
  edges          Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  runs AutomationRun[]

  @@map("automations")
}

model AutomationRun {
  id            String    @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  automationId  String    @map("automation_id") @db.Uuid
  subscriberId  String    @map("subscriber_id") @db.Uuid
  currentNodeId String?   @map("current_node_id")
  status        String    @default("running")
  nextRunAt     DateTime? @map("next_run_at") @db.Timestamptz
  context       Json      @default("{}")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  completedAt   DateTime? @map("completed_at") @db.Timestamptz

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  subscriber Contact    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@map("automation_runs")
}

model Form {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String
  formType        String   @default("inline") @map("form_type")
  title           String   @default("Join our newsletter")
  description     String   @default("")
  buttonText      String   @default("Subscribe") @map("button_text")
  successMessage  String   @default("Thanks for subscribing!") @map("success_message")
  redirectUrl     String?  @map("redirect_url")
  consentText     String   @default("I agree to receive email updates.") @map("consent_text")
  doubleOptIn    Boolean  @default(false) @map("double_opt_in")
  fields          Json     @default("[]")
  tagIds          String[] @default([]) @map("tag_ids") @db.Uuid
  published       Boolean  @default(true)
  submissionCount Int      @default(0) @map("submission_count")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("forms")
}

model LandingPage {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  slug            String   @unique @db.Citext
  title           String
  headline        String
  subheadline     String   @default("")
  bodyHtml        String   @default("") @map("body_html")
  heroImageUrl    String?  @map("hero_image_url")
  templateKey     String   @default("minimal") @map("template_key")
  buttonText      String   @default("Get Updates") @map("button_text")
  customDomain    String?  @map("custom_domain") @db.Citext
  formId          String?  @map("form_id") @db.Uuid
  tagIds          String[] @default([]) @map("tag_ids") @db.Uuid
  published       Boolean  @default(false)
  viewsCount      Int      @default(0) @map("views_count")
  conversionCount Int      @default(0) @map("conversion_count")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("landing_pages")
}
